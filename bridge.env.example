# Discord bot token for mcp-discord.
# Get this from https://discord.com/developers/applications -> your app -> Bot -> Reset Token.
# Copy this file to ".env" and paste the token below (no quotes).
DISCORD_TOKEN=

# Path to the mcp-discord folder (the one with build/index.js inside).
MCP_DISCORD_PATH=C:\Users\Cindy\Documents\mcp-discord

# Port mcp-discord listens on. Must match the URL baked into the extension.
MCP_DISCORD_PORT=8080
